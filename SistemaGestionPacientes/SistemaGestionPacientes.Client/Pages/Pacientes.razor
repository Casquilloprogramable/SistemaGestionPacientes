
@page "/pacientes"

@using SistemaGestionPacientes.Client.Models.Pacientes
@using SistemaGestionPacientes.Client.Services.Interfaces
@using Microsoft.AspNetCore.Components.Forms

@inject IPacientesApiService PacientesService

<PageTitle>Gestión de pacientes</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Gestión de pacientes</h2>
            <p class="text-muted">
                Administra los pacientes del centro médico.
            </p>
        </div>

        <button class="btn btn-primary"
                @onclick="NuevoPaciente">
            + Nuevo paciente
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert alert-info">
            @mensaje
        </div>
    }

    @if (mostrarFormulario)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <h5>@(editando ? "Editar paciente" : "Registrar paciente")</h5>
            </div>

            <div class="card-body">

                <EditForm Model="formulario"
                          OnValidSubmit="GuardarPaciente">

                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Nombres</label>
                            <InputText class="form-control"
                                       @bind-Value="formulario.Nombres" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Apellidos</label>
                            <InputText class="form-control"
                                       @bind-Value="formulario.Apellidos" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Documento</label>
                            <InputText class="form-control"
                                       @bind-Value="formulario.Documento" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Teléfono</label>
                            <InputText class="form-control"
                                       @bind-Value="formulario.Telefono" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Correo</label>
                            <InputText class="form-control"
                                       @bind-Value="formulario.Correo" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Fecha de nacimiento</label>
                            <InputDate class="form-control"
                                       @bind-Value="formulario.FechaNacimiento" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Dirección</label>
                            <InputText class="form-control"
                                       @bind-Value="formulario.Direccion" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Sexo</label>
                            <InputSelect class="form-select"
                                         @bind-Value="formulario.Sexo">
                                <option value="">Seleccione...</option>
                                <option value="Masculino">Masculino</option>
                                <option value="Femenino">Femenino</option>
                                <option value="Otro">Otro</option>
                            </InputSelect>
                        </div>

                    </div>

                    <button type="submit" class="btn btn-success me-2">
                        Guardar
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="Cancelar">
                        Cancelar
                    </button>

                </EditForm>

            </div>
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-header">
            <h5>Listado de pacientes</h5>
        </div>

        <div class="card-body">

            <input class="form-control mb-3"
                   placeholder="Buscar por nombre o documento..."
                   @bind="busqueda"
                   @bind:event="oninput" />

            @if (cargando)
            {
                <p>Cargando pacientes...</p>
            }
            else if (pacientesFiltrados.Count == 0)
            {
                <p class="text-muted">No hay pacientes registrados.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">

                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Paciente</th>
                                <th>Documento</th>
                                <th>Teléfono</th>
                                <th>Correo</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var paciente in pacientesFiltrados)
                            {
                                <tr>
                                    <td>@paciente.Id</td>
                                    <td>
                                        @paciente.Nombres @paciente.Apellidos
                                    </td>
                                    <td>@paciente.Documento</td>
                                    <td>@paciente.Telefono</td>
                                    <td>@paciente.Correo</td>
                                    <td>
                                        <button class="btn btn-sm btn-warning me-1"
                                                @onclick="() => EditarPaciente(paciente)">
                                            Editar
                                        </button>

                                        <button class="btn btn-sm btn-danger"
                                                @onclick="() => EliminarPaciente(paciente.Id)">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>

@code {

    private List<PacienteDTO> pacientes = new();

    private PacienteFormDTO formulario = new();

    private bool mostrarFormulario;
    private bool editando;
    private bool cargando = true;

    private int pacienteId;
    private string busqueda = string.Empty;
    private string mensaje = string.Empty;

    private List<PacienteDTO> pacientesFiltrados =>
        pacientes.Where(p =>
            $"{p.Nombres} {p.Apellidos} {p.Documento}"
            .Contains(busqueda, StringComparison.OrdinalIgnoreCase))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarPacientes();
    }

    private async Task CargarPacientes()
    {
        cargando = true;

        try
        {
            pacientes = await PacientesService.ObtenerTodosAsync();
        }
        catch (Exception)
        {
            mensaje = "No se pudo conectar con la API.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void NuevoPaciente()
    {
        formulario = new PacienteFormDTO();
        pacienteId = 0;
        editando = false;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void EditarPaciente(PacienteDTO paciente)
    {
        pacienteId = paciente.Id;

        formulario = new PacienteFormDTO
        {
            Nombres = paciente.Nombres,
            Apellidos = paciente.Apellidos,
            Documento = paciente.Documento,
            Telefono = paciente.Telefono,
            Correo = paciente.Correo,
            FechaNacimiento = paciente.FechaNacimiento,
            Direccion = paciente.Direccion,
            Sexo = paciente.Sexo
        };

        editando = true;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private async Task GuardarPaciente()
    {
        try
        {
            bool resultado;

            if (editando)
            {
                resultado = await PacientesService.ActualizarAsync(
                    pacienteId, formulario);
            }
            else
            {
                resultado = await PacientesService.CrearAsync(formulario);
            }

            if (resultado)
            {
                mensaje = editando
                    ? "Paciente actualizado correctamente."
                    : "Paciente registrado correctamente.";

                mostrarFormulario = false;

                await CargarPacientes();
            }
            else
            {
                mensaje = "No se pudo guardar el paciente. Verifica los datos.";
            }
        }
        catch (Exception)
        {
            mensaje = "Ocurrió un error al comunicarse con la API.";
        }
    }

    private async Task EliminarPaciente(int id)
    {
        try
        {
            bool resultado = await PacientesService.EliminarAsync(id);

            if (resultado)
            {
                mensaje = "Paciente eliminado correctamente.";
                await CargarPacientes();
            }
            else
            {
                mensaje = "No se pudo eliminar el paciente.";
            }
        }
        catch (Exception)
        {
            mensaje = "Error al eliminar el paciente.";
        }
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        formulario = new PacienteFormDTO();
    }
}
